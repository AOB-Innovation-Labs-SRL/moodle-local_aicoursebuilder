<?xml version="1.0"?>
<libraries>
  <library>
    <location>thirdparty/pdfparser</location>
    <name>smalot/pdfparser</name>
    <description>Reads PDF files and extracts their text; used by the PDF source extractor.</description>
    <version>2.12.5</version>
    <license>LGPL</license>
    <licenseversion>3.0</licenseversion>
    <repository>https://github.com/smalot/pdfparser</repository>
    <copyrights>
      <copyright>Sebastien Malot</copyright>
    </copyrights>
  </library>
  <library>
    <location>thirdparty/phpword</location>
    <name>phpoffice/phpword</name>
    <description>Reads DOCX files (headings, paragraphs, lists, tables); used by the DOCX source extractor. Only the reader is used.</description>
    <version>1.4.0</version>
    <license>LGPL</license>
    <licenseversion>3.0</licenseversion>
    <repository>https://github.com/PHPOffice/PHPWord</repository>
    <copyrights>
      <copyright>2010-2025 PHPWord contributors</copyright>
    </copyrights>
  </library>
  <library>
    <location>thirdparty/phppresentation</location>
    <name>phpoffice/phppresentation</name>
    <description>Reads PPTX files (slide text, tables, speaker notes); used by the PPTX source extractor. Only the reader is used.</description>
    <version>1.2.0</version>
    <license>LGPL</license>
    <licenseversion>3.0</licenseversion>
    <repository>https://github.com/PHPOffice/PHPPresentation</repository>
    <copyrights>
      <copyright>PHPPresentation contributors</copyright>
    </copyrights>
  </library>
  <library>
    <location>thirdparty/phpoffice-common</location>
    <name>phpoffice/common</name>
    <description>Shared helpers (XML reader, drawing) required by PhpPresentation.</description>
    <version>1.1.0</version>
    <license>LGPL</license>
    <licenseversion>3.0</licenseversion>
    <repository>https://github.com/PHPOffice/Common</repository>
    <copyrights>
      <copyright>PHPOffice contributors</copyright>
    </copyrights>
  </library>
  <library>
    <location>thirdparty/opis-json-schema</location>
    <name>opis/json-schema</name>
    <description>Validates the blueprint and the per-step fragments against the JSON Schema 2020-12 documents in schema/.</description>
    <version>2.6.0</version>
    <license>Apache</license>
    <licenseversion>2.0</licenseversion>
    <repository>https://github.com/opis/json-schema</repository>
    <copyrights>
      <copyright>Opis Project</copyright>
    </copyrights>
  </library>
  <library>
    <location>thirdparty/opis-string</location>
    <name>opis/string</name>
    <description>Multibyte string handling required by opis/json-schema and opis/uri.</description>
    <version>2.1.0</version>
    <license>Apache</license>
    <licenseversion>2.0</licenseversion>
    <repository>https://github.com/opis/string</repository>
    <copyrights>
      <copyright>Opis Project</copyright>
    </copyrights>
  </library>
  <library>
    <location>thirdparty/opis-uri</location>
    <name>opis/uri</name>
    <description>URI and URI template parsing required by opis/json-schema to resolve schema references.</description>
    <version>1.1.0</version>
    <license>Apache</license>
    <licenseversion>2.0</licenseversion>
    <repository>https://github.com/opis/uri</repository>
    <copyrights>
      <copyright>Opis Project</copyright>
    </copyrights>
  </library>
  <library>
    <location>thirdparty/phpoffice-math</location>
    <name>phpoffice/math</name>
    <description>Formula support required by PhpWord.</description>
    <version>0.3.0</version>
    <license>MIT</license>
    <repository>https://github.com/PHPOffice/Math</repository>
    <copyrights>
      <copyright>PHPOffice contributors</copyright>
    </copyrights>
  </library>
</libraries>
