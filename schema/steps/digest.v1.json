{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_aicoursebuilder/steps/digest.v1",
  "title": "Digest step output (v1)",
  "description": "Output of the digest step that runs for every source document before the pipeline: what the document says, with references to the chunks of the source. It is not part of the blueprint, so it defines its own shapes. Keys that are not listed are allowed and dropped by the digest builder, so that an answer with an extra key is not sent back for repair.",
  "type": "object",
  "required": ["title", "language", "concepts", "definitions", "objectives", "procedures"],
  "properties": {
    "title": {"type": "string"},
    "language": {"type": "string"},
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "chunks"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "chunks": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "definition", "chunks"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "chunks": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "objectives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "steps", "chunks"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "chunks": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        }
      }
    }
  }
}
