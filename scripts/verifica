#!/usr/bin/env bash
# Single verification entry point, used locally and by GitHub Actions (.github/workflows/ci.yml).
#
#   scripts/verifica schimbari after each task: only what changed against origin/main (docker backend only)
#   scripts/verifica rapid     iteration: syntax, coding style and the whole PHPUnit suite
#   scripts/verifica complet   before a PR: everything the environment can run
#
# schimbari: takes the .php files that differ from origin/main (commits, working tree and new files), runs php -l and
# phpcs on those files only, and PHPUnit on the test directories they map to (classes/builder/x.php -> tests/builder,
# a changed tests/**/*_test.php runs by itself). The whole suite runs instead when something global changed (db/,
# version.php, lib.php, lang/, schema/, prompts/, tests/fixtures/), or a changed file under classes/ has no test
# directory. No Behat: it runs in CI.
#
# The independent checks run as parallel processes; the log of each one is shown at the end, with a summary.
# Exit status is 0 only if every check passed (a skipped check is reported, and does not fail the run).
#
# Backend, chosen automatically (override with VERIFICA_BACKEND=ci|docker):
#   ci      on GitHub Actions: moodle-plugin-ci, which has to be installed already (`moodle-plugin-ci install`).
#           Runs phplint, phpcs, phpdoc, savepoints, mustache, grunt, phpunit and behat.
#   docker  locally: the Docker stack that mounts this plugin (AGENTS.md, Local environment). Runs php -l, phpcs (moodle-cs),
#           phpunit and behat in the webserver container; phpdoc is part of the moodle phpcs standard, and
#           savepoints, mustache and grunt exist only in moodle-plugin-ci, so they are left to CI.
#
# Variables (docker backend; none is needed when the stack of the plugin is running):
#   VERIFICA_CONTAINER   webserver container (default: the running one that mounts this plugin, found by itself)
#   VERIFICA_PHPCS       phpcs in the container (default: /tmp/quality/vendor/bin/phpcs or /quality/vendor/bin/phpcs)
#   VERIFICA_BEHAT_CONFIG behat.yml in the container (default: /var/www/behatdata/behatrun/behat/behat.yml)
#   VERIFICA_NO_BEHAT=1  skip behat (complet only)
#   VERIFICA_RESYNC=1    make the copy of Moodle again (it is also made again when public/version.php differs)
#   VERIFICA_NO_FAST=1   run PHPUnit in the mounted Moodle tree instead of the native copy (see below)
#
# Why PHPUnit runs from a copy of Moodle: after every test Moodle resets its class loader and scans the whole code
# tree again. On Docker Desktop (Windows/macOS) the mounted tree is on a slow file system, and that scan costs about
# 6 s per test: 768 tests took 92 minutes. The same tests take a few minutes from a copy on the container's own disk.
# The first run copies Moodle (a one-off, it can take 20+ minutes on Windows; the copy lives in the container and
# is lost when the container is recreated); every run copies the plugin again, which takes seconds.
set -u

level="${1:-}"
case "$level" in
    schimbari | rapid | complet) ;;
    *)
        echo "Usage: scripts/verifica schimbari|rapid|complet" >&2
        exit 2
        ;;
esac

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
backend="${VERIFICA_BACKEND:-$([ "${GITHUB_ACTIONS:-}" = "true" ] && echo ci || echo docker)}"
logdir="$(mktemp -d)"
trap 'rm -rf "$logdir"' EXIT

# MSYS (Git Bash) rewrites arguments that look like Unix paths; the container paths must reach docker as they are.
export MSYS_NO_PATHCONV=1

names=()
pids=()
skipped=()

# start NAME COMMAND...: runs the command in the background, its output goes to a log.
start() {
    local name="$1"
    shift
    names+=("$name")
    # The duration is measured inside the subshell: waiting for the jobs one by one would charge a fast check with
    # the time of the slower ones before it.
    (
        t=$(date +%s)
        "$@" >"$logdir/$name.log" 2>&1
        rc=$?
        echo $(($(date +%s) - t)) >"$logdir/$name.time"
        exit $rc
    ) &
    pids+=("$!")
}

skip() {
    skipped+=("$1: $2")
}

# ---- backend: ci ----------------------------------------------------------------------------------------------

ci_static() {
    # The static checks share one moodle-plugin-ci install and do not use the database; they run one after the
    # other so the cores stay for PHPUnit and Behat. Every one runs even if an earlier one failed.
    local rc=0 cmd
    for cmd in "phplint" "phpcs --max-warnings 0" "phpdoc --max-warnings 0" "savepoints" "mustache" \
        "grunt --max-lint-warnings 0"; do
        # No ::group:: here: GitHub does not nest groups, and this log is shown inside one.
        echo "=== moodle-plugin-ci $cmd"
        # shellcheck disable=SC2086
        moodle-plugin-ci $cmd || rc=1
    done
    return $rc
}

run_ci() {
    if [ "$level" = "schimbari" ]; then
        echo "The level schimbari exists only for the docker backend; CI runs complet." >&2
        exit 2
    fi
    start static ci_static
    start phpunit moodle-plugin-ci phpunit --fail-on-warning
    [ "$level" = "rapid" ] && return
    # Behat starts a browser and a second Moodle site, the slowest step: only when the plugin has a feature file.
    if compgen -G "$plugin_dir/tests/behat/*.feature" >/dev/null; then
        start behat moodle-plugin-ci behat --profile chrome
    else
        skip behat "no feature file in tests/behat"
    fi
}

# ---- changed files (level schimbari) --------------------------------------------------------------------------

# Sets: changed_php (existing .php files, not thirdparty), phpunit_all (1 = whole suite), phpunit_targets (paths
# relative to the plugin: test directories or files) and phpunit_reason.
pgit() {
    (cd "$plugin_dir" && git "$@")
}

compute_changes() {
    local base="origin/main" f d changed
    pgit rev-parse --verify -q "$base" >/dev/null || {
        echo "$base not found: run 'git fetch origin'." >&2
        exit 2
    }
    changed=$({
        pgit diff --name-only "$base"...HEAD
        pgit diff --name-only HEAD
        pgit ls-files -o --exclude-standard
    } | sort -u)
    changed_php=()
    phpunit_all=0
    phpunit_targets=()
    phpunit_reason=""
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        case "$f" in
            db/* | version.php | lib.php | lang/* | schema/* | prompts/* | tests/fixtures/*)
                phpunit_all=1
                phpunit_reason="$f is global"
                ;;
        esac
        # prompts/*.md are versioned prompts: they are code, not documentation.
        case "$f" in thirdparty/* | amd/build/* | .github/* | scripts/*) continue ;; prompts/*) ;; *.md) continue ;; esac
        [ -e "$plugin_dir/$f" ] || continue
        case "$f" in *.php) changed_php+=("$f") ;; esac
        case "$f" in
            classes/*/*)
                d="tests/$(echo "$f" | cut -d/ -f2)"
                if [ -d "$plugin_dir/$d" ]; then
                    phpunit_targets+=("$d")
                else
                    phpunit_all=1
                    phpunit_reason="$f has no test directory ($d)"
                fi
                ;;
            classes/*)
                phpunit_all=1
                phpunit_reason="$f is not in a subdirectory of classes/"
                ;;
            tests/behat/*) ;;
            tests/*_test.php | tests/*/*_test.php) phpunit_targets+=("$f") ;;
            tests/*/*) phpunit_targets+=("$(echo "$f" | cut -d/ -f1-2)") ;;
        esac
    done <<<"$changed"
    if [ "${#phpunit_targets[@]}" -gt 0 ]; then
        mapfile -t phpunit_targets < <(printf '%s\n' "${phpunit_targets[@]}" | sort -u)
    fi
}

# ---- backend: docker ------------------------------------------------------------------------------------------

dexec() {
    docker exec "$container" "$@"
}

# The webserver container of the stack that mounts this plugin: the one with a bind mount at the plugin path whose
# source ends with the name of the plugin directory. Whatever the stack or the service is called.
find_container() {
    local c base
    base="$(basename "$plugin_dir")"
    for c in $(docker ps --format '{{.Names}}' 2>/dev/null); do
        # One line per mount: "destination|source". The source is a Windows or a Unix path.
        if docker inspect "$c" --format '{{range .Mounts}}{{.Destination}}|{{.Source}}{{println}}{{end}}' 2>/dev/null \
            | grep -qiE "^/var/www/html/public/local/aicoursebuilder\|.*[/\\\\]$base\$"; then
            echo "$c"
            return
        fi
    done
}

# moodle-cs (phpcs with the moodle standard): the places where the stacks keep it.
find_phpcs() {
    local p
    for p in /tmp/quality/vendor/bin/phpcs /quality/vendor/bin/phpcs; do
        if dexec test -x "$p"; then
            echo "$p"
            return
        fi
    done
    echo /tmp/quality/vendor/bin/phpcs
}

# fast_tree FAST_ROOT: makes FAST_ROOT, a copy of the mounted Moodle on the container's own disk, with the current
# plugin and phpunit.xml in it. The Moodle copy is made again when it is missing, when VERIFICA_RESYNC=1, or when
# public/version.php of the mounted Moodle differs from the one in the copy (Moodle was updated).
fast_tree() {
    local fast="$1" src=/var/www/html why=""
    if ! dexec test -f "$fast/.synced"; then
        why="first run"
    elif [ "${VERIFICA_RESYNC:-}" = "1" ]; then
        why="VERIFICA_RESYNC=1"
    elif ! dexec cmp -s "$src/public/version.php" "$fast/public/version.php"; then
        why="Moodle was updated"
    fi
    if [ -n "$why" ]; then
        echo "Copying Moodle to $fast in the container ($why; can take 20+ minutes on Windows)..." >&2
        dexec sh -c "rm -rf $fast && mkdir -p $fast && cd $src             && tar cf - --exclude=./$plugin_rel --exclude=./node_modules . | tar xf - -C $fast             && touch $fast/.synced" || return 1
    fi
    dexec sh -c "cp $src/phpunit.xml $fast/phpunit.xml && rm -rf $fast/$plugin_rel && mkdir -p $fast/$plugin_rel         && cd $src/$plugin_rel && tar cf - --exclude=./.git . | tar xf - -C $fast/$plugin_rel" || return 1
}

run_docker() {
    container="${VERIFICA_CONTAINER:-$(find_container)}"
    local phpcs behatcfg="${VERIFICA_BEHAT_CONFIG:-/var/www/behatdata/behatrun/behat/behat.yml}"
    plugin_rel="public/local/aicoursebuilder"
    local plugin="/var/www/html/$plugin_rel"

    if [ -z "$container" ] || ! docker exec "$container" true 2>/dev/null; then
        echo "No running container has this plugin mounted at $plugin. Start the Docker stack of the plugin (AGENTS.md," >&2
        echo "Local environment) or set VERIFICA_CONTAINER to its webserver container." >&2
        exit 2
    fi
    phpcs="${VERIFICA_PHPCS:-$(find_phpcs)}"
    echo "Container: $container"

    # What php -l and phpcs look at: the whole plugin, or only the changed files (paths have no spaces or quotes).
    local listfiles="find . -name '*.php' -not -path './thirdparty/*' -print0" phpcsfiles="."
    if [ "$level" = "schimbari" ]; then
        compute_changes
        echo "Changed .php files: ${#changed_php[@]}"
        listfiles="printf '%s\\0' ${changed_php[*]:-}"
        phpcsfiles="${changed_php[*]:-}"
    fi

    if [ "$level" = "schimbari" ] && [ "${#changed_php[@]}" -eq 0 ]; then
        skip "phplint, phpcs" "no changed .php file"
    else
        start phplint dexec sh -c "cd $plugin && out=\$($listfiles | xargs -0 -n40 -P8 php -l 2>&1 \
            | grep -v '^No syntax errors') ; [ -z \"\$out\" ] || { echo \"\$out\"; exit 1; }"
    fi

    if [ "$level" = "schimbari" ] && [ "${#changed_php[@]}" -eq 0 ]; then
        :
    elif dexec test -x "$phpcs"; then
        start phpcs dexec sh -c "cd $plugin && php -d memory_limit=1G $phpcs --standard=moodle --extensions=php --warning-severity=1 --ignore=*/thirdparty/*,*/amd/build/*,*/vendor/*,*/node_modules/* -q $phpcsfiles"
    else
        skip phpcs "moodle-cs not found in the container: set VERIFICA_PHPCS, or install it (README.md, Verification script)"
    fi

    local moodleroot=/var/www/html
    if [ "${VERIFICA_NO_FAST:-}" != "1" ]; then
        moodleroot=/opt/moodle-fast
        fast_tree "$moodleroot" || exit 2
    fi
    if [ "$level" != "schimbari" ] || [ "$phpunit_all" = "1" ]; then
        [ "$level" = "schimbari" ] && echo "PHPUnit: whole suite ($phpunit_reason)"
        start phpunit dexec sh -c "cd $moodleroot && vendor/bin/phpunit --testsuite local_aicoursebuilder_testsuite"
    elif [ "${#phpunit_targets[@]}" -gt 0 ]; then
        echo "PHPUnit: ${phpunit_targets[*]}"
        # PHPUnit takes one path per run, so the targets run one after the other; every one runs even if an
        # earlier one failed.
        local cmd="rc=0;" t
        for t in "${phpunit_targets[@]}"; do
            cmd+=" vendor/bin/phpunit $plugin_rel/$t || rc=1;"
        done
        start phpunit dexec sh -c "cd $moodleroot && $cmd exit \$rc"
    else
        skip phpunit "no changed file maps to a test"
    fi

    if [ "$level" = "complet" ]; then
        if [ "${VERIFICA_NO_BEHAT:-}" = "1" ]; then
            skip behat "VERIFICA_NO_BEHAT=1"
        elif dexec test -f "$behatcfg"; then
            start behat dexec sh -c "cd /var/www/html && vendor/bin/behat --config $behatcfg public/local/aicoursebuilder/tests/behat"
        else
            skip behat "not initialised in the container (php public/admin/tool/behat/cli/init.php)"
        fi
        skip "phpdoc, savepoints, mustache, grunt" "only available through moodle-plugin-ci: they run in CI"
    fi
}

# ---- run ------------------------------------------------------------------------------------------------------

t0=$(date +%s)
echo "verifica $level (backend: $backend)"
case "$backend" in
    ci) run_ci ;;
    docker) run_docker ;;
    *)
        echo "Unknown backend: $backend" >&2
        exit 2
        ;;
esac

status=0
results=()
for i in "${!pids[@]}"; do
    if wait "${pids[$i]}"; then
        rc=0
    else
        rc=1
        status=1
    fi
    results+=("$rc:$(cat "$logdir/${names[$i]}.time" 2>/dev/null || echo "?")")
done

echo
for i in "${!names[@]}"; do
    rc="${results[$i]%%:*}"
    if [ "$rc" != "0" ]; then
        echo "::group::LOG ${names[$i]} (FAILED)"
        cat "$logdir/${names[$i]}.log"
        echo "::endgroup::"
    else
        echo "::group::log ${names[$i]}"
        tail -n 15 "$logdir/${names[$i]}.log"
        echo "::endgroup::"
    fi
done

echo
echo "== Summary =="
for i in "${!names[@]}"; do
    rc="${results[$i]%%:*}"
    printf '%-10s %s (%ss)\n' "${names[$i]}" "$([ "$rc" = "0" ] && echo OK || echo FAILED)" "${results[$i]#*:}"
done
for s in "${skipped[@]+"${skipped[@]}"}"; do
    echo "SKIPPED    $s"
done
echo "Total: $(($(date +%s) - t0))s"
exit $status
