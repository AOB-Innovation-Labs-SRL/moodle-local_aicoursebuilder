{{!
    @template local_aicoursebuilder/wizard

    The course generation wizard: the form with one step shown at a time, the buttons that move between the
    steps, and the places where the wizard script shows the error and the progress of the job.

    Context variables required for this template:
    * form - The HTML of the wizard form

    Example context (json):
    {
        "form": "<form class=\"mform\"><fieldset><legend>Step</legend></fieldset></form>"
    }
}}
<div data-region="aicb-wizard">
    <div data-region="aicb-error" class="alert alert-danger d-none" role="alert"></div>

    <div data-region="aicb-steps">
        <p class="text-muted" data-region="aicb-stepindicator" aria-live="polite"></p>
        <div data-region="aicb-form">
            {{{form}}}
        </div>
        <div class="d-flex justify-content-between mt-3" data-region="aicb-nav">
            <button type="button" class="btn btn-secondary" data-action="aicb-back">
                {{#str}} wizard:back, local_aicoursebuilder {{/str}}
            </button>
            <div>
                <button type="button" class="btn btn-primary" data-action="aicb-next">
                    {{#str}} wizard:next, local_aicoursebuilder {{/str}}
                </button>
                <button type="button" class="btn btn-primary d-none" data-action="aicb-start">
                    {{#str}} wizard:start, local_aicoursebuilder {{/str}}
                </button>
            </div>
        </div>
    </div>

    <div data-region="aicb-progress" class="d-none" aria-live="polite"></div>
</div>
