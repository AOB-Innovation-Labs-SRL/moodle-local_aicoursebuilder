{{!
    @template local_aicoursebuilder/job

    The page of a generation job: what it was asked for, and the place where its progress is shown.

    Context variables required for this template:
    * prompt - What the teacher asked for

    Example context (json):
    {
        "prompt": "An introductory course about renewable energy"
    }
}}
<div data-region="aicb-job">
    <div data-region="aicb-job-error" class="alert alert-danger d-none" role="alert"></div>
    <p class="lead">{{prompt}}</p>
    <div data-region="aicb-job-progress" aria-live="polite"></div>
</div>
