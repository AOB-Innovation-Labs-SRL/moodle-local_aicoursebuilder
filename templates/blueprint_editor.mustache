{{!
    @template local_aicoursebuilder/blueprint_editor

    The frame of the blueprint editor: the buttons, the messages, the tree of the course and the place where the
    selected part of it is edited. The editor script fills the tree and the part being edited.

    Context variables required for this template:
    * editable - Whether the teacher can change the blueprint
    * prompt - What the teacher asked for

    Example context (json):
    {
        "editable": true,
        "prompt": "An introductory course about renewable energy"
    }
}}
<div data-region="aicb-editor">
    <p class="lead">{{prompt}}</p>

    <div data-region="aicb-editor-message" class="alert d-none" role="status" aria-live="polite"></div>

    <div class="d-flex flex-wrap align-items-center mb-3">
        <span class="text-muted mr-auto" data-region="aicb-editor-status" aria-live="polite"></span>
        {{#editable}}
            <button type="button" class="btn btn-secondary mr-2" data-action="aicb-save" disabled>
                {{#str}} editor:save, local_aicoursebuilder {{/str}}
            </button>
            <button type="button" class="btn btn-primary" data-action="aicb-approve">
                {{#str}} editor:approve, local_aicoursebuilder {{/str}}
            </button>
        {{/editable}}
    </div>

    <div data-region="aicb-editor-errors" class="alert alert-warning d-none" role="alert"></div>

    <div class="row">
        <div class="col-md-5 mb-3">
            <h2 class="h5">{{#str}} editor:treetitle, local_aicoursebuilder {{/str}}</h2>
            <div data-region="aicb-editor-tree"></div>
        </div>
        <div class="col-md-7 mb-3">
            <div data-region="aicb-editor-node" aria-live="polite"></div>
        </div>
    </div>
</div>
