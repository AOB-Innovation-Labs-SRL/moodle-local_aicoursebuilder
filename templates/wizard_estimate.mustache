{{!
    @template local_aicoursebuilder/wizard_estimate

    The estimated cost of a job, shown before the teacher starts it.

    Context variables required for this template:
    * cost - The estimated cost, formatted, in USD
    * tokensin - The estimated input tokens, formatted
    * tokensout - The estimated output tokens, formatted
    * withinbudget - Whether the estimate fits the cost limits
    * hasjoblimit - Whether there is a limit per job
    * joblimit - The limit per job, formatted
    * hasuserlimit - Whether the user has a monthly limit
    * userremaining - What is left of it, formatted
    * useralert - Whether the user has used the alert percentage of the monthly limit

    Example context (json):
    {
        "cost": "0.1700",
        "tokensin": "550,000",
        "tokensout": "140,000",
        "withinbudget": true,
        "hasjoblimit": true,
        "joblimit": "5.00",
        "hasuserlimit": true,
        "userremaining": "9.83",
        "useralert": false
    }
}}
<div class="card mb-3" data-region="aicb-estimate-card">
    <div class="card-body">
        <h3 class="h5 card-title">{{#str}} wizard:estimatetitle, local_aicoursebuilder {{/str}}</h3>
        <p class="display-6 mb-1" data-region="aicb-estimate-cost">{{cost}} USD</p>
        <p class="text-muted mb-2">
            {{#str}} wizard:estimatetokens, local_aicoursebuilder, { "in": "{{tokensin}}", "out": "{{tokensout}}" } {{/str}}
        </p>
        <ul class="list-unstyled mb-2">
            {{#hasjoblimit}}
                <li>{{#str}} wizard:estimatejoblimit, local_aicoursebuilder, {{joblimit}} {{/str}}</li>
            {{/hasjoblimit}}
            {{#hasuserlimit}}
                <li>{{#str}} wizard:estimateuserremaining, local_aicoursebuilder, {{userremaining}} {{/str}}</li>
            {{/hasuserlimit}}
        </ul>
        {{#useralert}}
            <div class="alert alert-warning" role="alert" data-region="aicb-estimate-alert">
                {{#str}} wizard:estimatealert, local_aicoursebuilder {{/str}}
            </div>
        {{/useralert}}
        {{^withinbudget}}
            <div class="alert alert-warning mb-0" role="alert">
                {{#str}} wizard:estimateoverbudget, local_aicoursebuilder {{/str}}
            </div>
        {{/withinbudget}}
        {{#withinbudget}}
            <p class="mb-0 text-muted">{{#str}} wizard:estimateapproximate, local_aicoursebuilder {{/str}}</p>
        {{/withinbudget}}
    </div>
</div>
